{# FRR integrated config for a spine or a leaf. Variables: node, role. #}
{% set ifaces = [] %}
{% for link in fabric_links %}
{%   for end in link if end.split(':')[0] == node.name %}
{%     set _ = ifaces.append(end.split(':')[1]) %}
{%   endfor %}
{% endfor %}
! Rendered from inventory/fabric.yml. Do not edit on the device.
frr defaults datacenter
hostname {{ node.name }}
log stdout informational
service integrated-vtysh-config
!
{% if role == 'leaf' %}
{%   for vrf in vrfs %}
vrf {{ vrf.name }}
 vni {{ vrf.l3vni }}
exit-vrf
!
{%   endfor %}
{% endif %}
interface lo
 ip address {{ node.loopback }}/32
exit
!
{% for ifname in ifaces %}
interface {{ ifname }}
 ipv6 nd ra-interval 5
 no ipv6 nd suppress-ra
exit
!
{% endfor %}
router bgp {{ node.asn }}
 bgp router-id {{ node.loopback }}
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 bgp bestpath as-path multipath-relax
 neighbor FABRIC peer-group
 neighbor FABRIC remote-as external
 neighbor FABRIC bfd
{% for ifname in ifaces %}
 neighbor {{ ifname }} interface peer-group FABRIC
{% endfor %}
 !
 address-family ipv4 unicast
  network {{ node.loopback }}/32
  neighbor FABRIC activate
  maximum-paths 8
 exit-address-family
 !
 address-family l2vpn evpn
  neighbor FABRIC activate
{% if role == 'spine' %}
  neighbor FABRIC attribute-unchanged next-hop
{% else %}
  advertise-all-vni
{%   for vlan in vlans %}
  vni {{ vlan.vni }}
   route-target import {{ rt_prefix }}:{{ vlan.vni }}
   route-target export {{ rt_prefix }}:{{ vlan.vni }}
  exit-vni
{%   endfor %}
{% endif %}
 exit-address-family
exit
!
{% if role == 'leaf' %}
{%   for vrf in vrfs %}
router bgp {{ node.asn }} vrf {{ vrf.name }}
 bgp router-id {{ node.loopback }}
 no bgp ebgp-requires-policy
 !
 address-family ipv4 unicast
  redistribute connected
 exit-address-family
 !
 address-family l2vpn evpn
  advertise ipv4 unicast
  route-target import {{ rt_prefix }}:{{ vrf.l3vni }}
  route-target export {{ rt_prefix }}:{{ vrf.l3vni }}
 exit-address-family
exit
!
{%   endfor %}
{% endif %}
