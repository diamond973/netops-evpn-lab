---
# Rendered from inventory/fabric.yml by playbooks/render.yml. Do not edit.
name: {{ lab_name }}

topology:
  nodes:
{% for node in spines + leafs %}
    {{ node.name }}:
      kind: linux
      image: {{ images.frr }}
      binds:
        - ../files/frr/daemons:/etc/frr/daemons:ro
        - ../files/frr/vtysh.conf:/etc/frr/vtysh.conf:ro
      sysctls:
        net.ipv4.ip_forward: 1
        net.ipv6.conf.all.forwarding: 1
        net.ipv6.conf.all.disable_ipv6: 0
        net.ipv4.conf.all.rp_filter: 0
        net.ipv4.conf.default.rp_filter: 0
{% endfor %}
{% for host in hosts %}
    {{ host.name }}:
      kind: linux
      image: {{ images.host }}
{% endfor %}

  links:
{% for a, b in fabric_links %}
    - endpoints: ["{{ a }}", "{{ b }}"]
{% endfor %}
{% for host in hosts %}
    - endpoints: ["{{ host.leaf }}:{{ host.leaf_port }}", "{{ host.name }}:eth1"]
{% endfor %}
